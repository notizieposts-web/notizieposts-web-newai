:"1,85"},{"Descrizione":"Trasporto","Quantita":"19","PrezzoUnitario":"95,00"},{"Descrizione":"Manutenzione ordinaria","Quantita":"15","PrezzoUnitario":"180,00"},{"Descrizione":"Raccordo a T","Quantita":"4","PrezzoUnitario":"3,60"}]},"out":{"totale_righe":4573.05}},{"in":{"Righe":[{"Descrizione":"Trasporto","Quantita":"6","PrezzoUnitario":"95,00"},{"Descrizione":"Scatola cartone 40x30","Quantita":"7","PrezzoUnitario":"0,92"},{"Descrizione":"Licenza software annuale","Quantita":"13","PrezzoUnitario":"240,00"},{"Descrizione":"Toner nero","Quantita":"2","PrezzoUnitario":"64,00"}]},"out":{"totale_righe":3824.44}},{"in":{"Righe":[{"Descrizione":"Valvola a sfera 1\"","Quantita":"23","PrezzoUnitario":"18,40"}]},"out":{"totale_righe":423.2}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var t = input.Righe.reduce(function(a, r){ return a + n(r.Quantita) * n(r.PrezzoUnitario); }, 0);\n  if (input.Sconto) t = t * (1 - n(String(input.Sconto).replace('%', '')) / 100);\n  return { totale_righe: Math.round(t * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    t = sum(n(r['Quantita']) * n(r['PrezzoUnitario']) for r in campi['Righe'])\n    if campi.get('Sconto'):\n        t *= 1 - n(str(campi['Sconto']).replace('%', '')) / 100\n    return {'totale_righe': round(t, 2)}","gen":{"tin":1100,"tout":14},"id":525,"track":"trasforma","d":"M","pts":40,"giorno":"2026-11-06","k":18}