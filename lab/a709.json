ponibile":702.8,"iva":28.11}],"totale":2898.11}},{"in":{"Righe":[{"Importo":"747,22","Aliquota":"22%"},{"Importo":"625,56","Aliquota":"4%"},{"Importo":"705,51","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1452.73,"iva":319.6},{"aliquota":4,"imponibile":625.56,"iva":25.02}],"totale":2422.91}},{"in":{"Righe":[{"Importo":"67,42","Aliquota":"10%"},{"Importo":"758,59","Aliquota":"10%"},{"Importo":"866,21","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":10,"imponibile":826.01,"iva":82.6},{"aliquota":4,"imponibile":866.21,"iva":34.65}],"totale":1809.47}},{"in":{"Righe":[{"Importo":"649,24","Aliquota":"22%"},{"Importo":"20,72","Aliquota":"22%"},{"Importo":"494,07","Aliquota":"22%"},{"Importo":"640,81","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1804.84,"iva":397.06}],"totale":2201.9}},{"in":{"Righe":[{"Importo":"745,14","Aliquota":"10%"},{"Importo":"103,95","Aliquota":"10%"},{"Importo":"746,99","Aliquota":"22%"},{"Importo":"628,77","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":746.99,"iva":164.34},{"aliquota":10,"imponibile":1477.86,"iva":147.79}],"totale":2536.98}},{"in":{"Righe":[{"Importo":"638,16","Aliquota":"10%"},{"Importo":"741,61","Aliquota":"10%"},{"Importo":"359,08","Aliquota":"10%"},{"Importo":"710,64","Aliquota":"10%"},{"Importo":"266,61","Aliquota":"22%"},{"Importo":"605,21","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":871.82,"iva":191.8},{"aliquota":10,"imponibile":2449.49,"iva":244.95}],"totale":3758.06}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":709,"track":"trasforma","d":"D","pts":80,"giorno":"2026-11-12","k":24}