9.82,"iva":71.99}],"totale":2502.62}},{"in":{"Righe":[{"Importo":"682,94","Aliquota":"4%"},{"Importo":"470,81","Aliquota":"10%"},{"Importo":"591,80","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":591.8,"iva":130.2},{"aliquota":10,"imponibile":470.81,"iva":47.08},{"aliquota":4,"imponibile":682.94,"iva":27.32}],"totale":1950.15}},{"in":{"Righe":[{"Importo":"444,83","Aliquota":"22%"},{"Importo":"108,07","Aliquota":"22%"},{"Importo":"194,63","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":552.9,"iva":121.64},{"aliquota":10,"imponibile":194.63,"iva":19.46}],"totale":888.63}},{"in":{"Righe":[{"Importo":"178,43","Aliquota":"22%"},{"Importo":"766,40","Aliquota":"22%"},{"Importo":"648,76","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1593.59,"iva":350.59}],"totale":1944.18}},{"in":{"Righe":[{"Importo":"898,06","Aliquota":"4%"},{"Importo":"741,03","Aliquota":"10%"},{"Importo":"756,79","Aliquota":"22%"},{"Importo":"327,81","Aliquota":"22%"},{"Importo":"430,91","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1515.51,"iva":333.41},{"aliquota":10,"imponibile":741.03,"iva":74.1},{"aliquota":4,"imponibile":898.06,"iva":35.92}],"totale":3598.03}},{"in":{"Righe":[{"Importo":"749,32","Aliquota":"4%"},{"Importo":"28,31","Aliquota":"22%"},{"Importo":"182,69","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":211.0,"iva":46.42},{"aliquota":4,"imponibile":749.32,"iva":29.97}],"totale":1036.71}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":469,"track":"trasforma","d":"D","pts":80,"giorno":"2026-11-04","k":16}