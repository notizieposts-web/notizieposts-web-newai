rto":"270,14","Aliquota":"22%"},{"Importo":"719,67","Aliquota":"10%"},{"Importo":"747,39","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1498.9,"iva":329.76},{"aliquota":10,"imponibile":1538.1,"iva":153.81}],"totale":3520.57}},{"in":{"Righe":[{"Importo":"502,85","Aliquota":"22%"},{"Importo":"63,91","Aliquota":"4%"},{"Importo":"606,32","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1109.17,"iva":244.02},{"aliquota":4,"imponibile":63.91,"iva":2.56}],"totale":1419.66}},{"in":{"Righe":[{"Importo":"832,95","Aliquota":"22%"},{"Importo":"790,16","Aliquota":"10%"},{"Importo":"136,44","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":832.95,"iva":183.25},{"aliquota":10,"imponibile":926.6,"iva":92.66}],"totale":2035.46}},{"in":{"Righe":[{"Importo":"474,98","Aliquota":"22%"},{"Importo":"488,91","Aliquota":"22%"},{"Importo":"793,18","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1757.07,"iva":386.56}],"totale":2143.63}},{"in":{"Righe":[{"Importo":"265,38","Aliquota":"4%"},{"Importo":"703,87","Aliquota":"22%"},{"Importo":"293,90","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":997.77,"iva":219.51},{"aliquota":4,"imponibile":265.38,"iva":10.62}],"totale":1493.28}},{"in":{"Righe":[{"Importo":"611,02","Aliquota":"4%"},{"Importo":"781,60","Aliquota":"4%"},{"Importo":"439,17","Aliquota":"10%"},{"Importo":"638,82","Aliquota":"10%"},{"Importo":"811,58","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":811.58,"iva":178.55},{"aliquota":10,"imponibile":1077.99,"iva":107.8},{"aliquota":4,"imponibile":1392.62,"iva":55.7}],"totale":3624.24}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":829,"track":"trasforma","d":"D","pts":80,"giorno":"2026-11-16","k":28}