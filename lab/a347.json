:[{"Descrizione":"Filtro aria","Quantita":"27","PrezzoUnitario":"22,50"},{"Descrizione":"Toner nero","Quantita":"14","PrezzoUnitario":"64,00"},{"Descrizione":"Filtro aria","Quantita":"27","PrezzoUnitario":"22,50"},{"Descrizione":"Pallet EPAL","Quantita":"23","PrezzoUnitario":"11,50"},{"Descrizione":"Manutenzione ordinaria","Quantita":"10","PrezzoUnitario":"180,00"}]},"out":{"totale_righe":4175.5}},{"in":{"Righe":[{"Descrizione":"Pallet EPAL","Quantita":"7","PrezzoUnitario":"11,50"},{"Descrizione":"Pallet EPAL","Quantita":"27","PrezzoUnitario":"11,50"},{"Descrizione":"Bulloni M8 inox","Quantita":"20","PrezzoUnitario":"0,35"},{"Descrizione":"Filtro aria","Quantita":"28","PrezzoUnitario":"22,50"}]},"out":{"totale_righe":1028.0}},{"in":{"Righe":[{"Descrizione":"Toner nero","Quantita":"5","PrezzoUnitario":"64,00"}]},"out":{"totale_righe":320.0}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var t = input.Righe.reduce(function(a, r){ return a + n(r.Quantita) * n(r.PrezzoUnitario); }, 0);\n  if (input.Sconto) t = t * (1 - n(String(input.Sconto).replace('%', '')) / 100);\n  return { totale_righe: Math.round(t * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    t = sum(n(r['Quantita']) * n(r['PrezzoUnitario']) for r in campi['Righe'])\n    if campi.get('Sconto'):\n        t *= 1 - n(str(campi['Sconto']).replace('%', '')) / 100\n    return {'totale_righe': round(t, 2)}","gen":{"tin":1100,"tout":14},"id":347,"track":"trasforma","d":"M","pts":40,"giorno":"2026-10-31","k":12}