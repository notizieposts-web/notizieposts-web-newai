quota":10,"imponibile":724.9,"iva":72.49},{"aliquota":4,"imponibile":206.71,"iva":8.27}],"totale":1012.37}},{"in":{"Righe":[{"Importo":"712,36","Aliquota":"4%"},{"Importo":"119,22","Aliquota":"22%"},{"Importo":"526,13","Aliquota":"22%"},{"Importo":"475,50","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":645.35,"iva":141.98},{"aliquota":10,"imponibile":475.5,"iva":47.55},{"aliquota":4,"imponibile":712.36,"iva":28.49}],"totale":2051.23}},{"in":{"Righe":[{"Importo":"632,92","Aliquota":"22%"},{"Importo":"569,96","Aliquota":"22%"},{"Importo":"835,16","Aliquota":"4%"},{"Importo":"296,67","Aliquota":"4%"},{"Importo":"578,85","Aliquota":"4%"},{"Importo":"118,41","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1202.88,"iva":264.63},{"aliquota":4,"imponibile":1829.09,"iva":73.16}],"totale":3369.76}},{"in":{"Righe":[{"Importo":"212,45","Aliquota":"22%"},{"Importo":"509,98","Aliquota":"22%"},{"Importo":"23,83","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":746.26,"iva":164.18}],"totale":910.44}},{"in":{"Righe":[{"Importo":"885,01","Aliquota":"10%"},{"Importo":"710,29","Aliquota":"10%"},{"Importo":"224,97","Aliquota":"4%"},{"Importo":"118,03","Aliquota":"10%"},{"Importo":"246,84","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":10,"imponibile":1713.33,"iva":171.33},{"aliquota":4,"imponibile":471.81,"iva":18.87}],"totale":2375.34}},{"in":{"Righe":[{"Importo":"698,46","Aliquota":"22%"},{"Importo":"328,73","Aliquota":"10%"},{"Importo":"652,40","Aliquota":"4%"},{"Importo":"338,80","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1037.26,"iva":228.2},{"aliquota":10,"imponibile":328.73,"iva":32.87},{"aliquota":4,"imponibile":652.4,"iva":26.1}],"totale":2305.56}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":1160,"track":"trasforma","d":"D","pts":80,"giorno":"2026-11-27","k":39}