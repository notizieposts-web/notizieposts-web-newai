Importo":"451,89","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":451.89,"iva":99.42},{"aliquota":10,"imponibile":78.78,"iva":7.88},{"aliquota":4,"imponibile":253.4,"iva":10.14}],"totale":901.51}},{"in":{"Righe":[{"Importo":"473,40","Aliquota":"10%"},{"Importo":"558,42","Aliquota":"4%"},{"Importo":"162,36","Aliquota":"10%"},{"Importo":"484,74","Aliquota":"4%"},{"Importo":"776,90","Aliquota":"22%"},{"Importo":"219,63","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":996.53,"iva":219.24},{"aliquota":10,"imponibile":635.76,"iva":63.58},{"aliquota":4,"imponibile":1043.16,"iva":41.73}],"totale":3000.0}},{"in":{"Righe":[{"Importo":"529,25","Aliquota":"22%"},{"Importo":"86,91","Aliquota":"22%"},{"Importo":"632,25","Aliquota":"22%"},{"Importo":"285,68","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1248.41,"iva":274.65},{"aliquota":10,"imponibile":285.68,"iva":28.57}],"totale":1837.31}},{"in":{"Righe":[{"Importo":"705,77","Aliquota":"22%"},{"Importo":"340,61","Aliquota":"22%"},{"Importo":"696,35","Aliquota":"22%"},{"Importo":"620,13","Aliquota":"22%"},{"Importo":"689,68","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":3052.54,"iva":671.56}],"totale":3724.1}},{"in":{"Righe":[{"Importo":"566,28","Aliquota":"22%"},{"Importo":"660,40","Aliquota":"10%"},{"Importo":"103,38","Aliquota":"4%"},{"Importo":"420,97","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":566.28,"iva":124.58},{"aliquota":10,"imponibile":1081.37,"iva":108.14},{"aliquota":4,"imponibile":103.38,"iva":4.14}],"totale":1987.89}},{"in":{"Righe":[{"Importo":"506,74","Aliquota":"22%"},{"Importo":"382,34","Aliquota":"22%"},{"Importo":"15,70","Aliquota":"22%"},{"Importo":"453,74","Aliquota":"4%"},{"Importo":"113,36","Aliquota":"10%"},{"Importo":"689,05","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1593.83,"iva":350.64},{"aliquota":10,"imponibile":113.36,"iva":11.34},{"aliquota":4,"imponibile":453.74,"iva":18.15}],"totale":2541.06}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":680,"track":"trasforma","d":"D","pts":80,"giorno":"2026-11-11","k":23}