a":10,"imponibile":562.49,"iva":56.25}],"totale":2238.0}},{"in":{"Righe":[{"Importo":"76,55","Aliquota":"10%"},{"Importo":"267,16","Aliquota":"10%"},{"Importo":"413,73","Aliquota":"10%"},{"Importo":"189,55","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":189.55,"iva":41.7},{"aliquota":10,"imponibile":757.44,"iva":75.74}],"totale":1064.43}},{"in":{"Righe":[{"Importo":"316,70","Aliquota":"22%"},{"Importo":"605,77","Aliquota":"4%"},{"Importo":"254,13","Aliquota":"4%"},{"Importo":"350,84","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":316.7,"iva":69.67},{"aliquota":10,"imponibile":350.84,"iva":35.08},{"aliquota":4,"imponibile":859.9,"iva":34.4}],"totale":1666.59}},{"in":{"Righe":[{"Importo":"364,14","Aliquota":"22%"},{"Importo":"202,36","Aliquota":"22%"},{"Importo":"717,94","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1284.44,"iva":282.58}],"totale":1567.02}},{"in":{"Righe":[{"Importo":"397,93","Aliquota":"22%"},{"Importo":"604,01","Aliquota":"10%"},{"Importo":"877,65","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":397.93,"iva":87.54},{"aliquota":10,"imponibile":1481.66,"iva":148.17}],"totale":2115.3}},{"in":{"Righe":[{"Importo":"814,83","Aliquota":"10%"},{"Importo":"403,31","Aliquota":"22%"},{"Importo":"708,23","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1111.54,"iva":244.54},{"aliquota":10,"imponibile":814.83,"iva":81.48}],"totale":2252.39}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":560,"track":"trasforma","d":"D","pts":80,"giorno":"2026-11-07","k":19}