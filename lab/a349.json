"Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1038.58,"iva":228.49},{"aliquota":10,"imponibile":692.32,"iva":69.23}],"totale":2028.62}},{"in":{"Righe":[{"Importo":"860,92","Aliquota":"22%"},{"Importo":"804,60","Aliquota":"10%"},{"Importo":"381,05","Aliquota":"22%"},{"Importo":"492,82","Aliquota":"22%"},{"Importo":"402,01","Aliquota":"22%"},{"Importo":"772,61","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":2136.8,"iva":470.1},{"aliquota":10,"imponibile":804.6,"iva":80.46},{"aliquota":4,"imponibile":772.61,"iva":30.9}],"totale":4295.47}},{"in":{"Righe":[{"Importo":"225,89","Aliquota":"22%"},{"Importo":"19,85","Aliquota":"22%"},{"Importo":"301,12","Aliquota":"4%"},{"Importo":"64,10","Aliquota":"10%"},{"Importo":"653,76","Aliquota":"10%"},{"Importo":"578,37","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":824.11,"iva":181.3},{"aliquota":10,"imponibile":717.86,"iva":71.79},{"aliquota":4,"imponibile":301.12,"iva":12.04}],"totale":2108.22}},{"in":{"Righe":[{"Importo":"373,56","Aliquota":"22%"},{"Importo":"671,53","Aliquota":"22%"},{"Importo":"292,47","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1337.56,"iva":294.26}],"totale":1631.82}},{"in":{"Righe":[{"Importo":"93,86","Aliquota":"10%"},{"Importo":"410,37","Aliquota":"22%"},{"Importo":"416,34","Aliquota":"4%"},{"Importo":"701,21","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":410.37,"iva":90.28},{"aliquota":10,"imponibile":93.86,"iva":9.39},{"aliquota":4,"imponibile":1117.55,"iva":44.7}],"totale":1766.15}},{"in":{"Righe":[{"Importo":"702,74","Aliquota":"10%"},{"Importo":"358,18","Aliquota":"22%"},{"Importo":"436,04","Aliquota":"22%"},{"Importo":"684,96","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1479.18,"iva":325.42},{"aliquota":10,"imponibile":702.74,"iva":70.27}],"totale":2577.61}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":349,"track":"trasforma","d":"D","pts":80,"giorno":"2026-10-31","k":12}