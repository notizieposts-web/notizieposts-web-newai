:351.21}],"totale":1947.62}},{"in":{"Righe":[{"Importo":"40,92","Aliquota":"22%"},{"Importo":"335,08","Aliquota":"4%"},{"Importo":"578,20","Aliquota":"22%"},{"Importo":"35,27","Aliquota":"10%"},{"Importo":"682,22","Aliquota":"4%"},{"Importo":"239,36","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":858.48,"iva":188.87},{"aliquota":10,"imponibile":35.27,"iva":3.53},{"aliquota":4,"imponibile":1017.3,"iva":40.69}],"totale":2144.14}},{"in":{"Righe":[{"Importo":"92,45","Aliquota":"4%"},{"Importo":"291,71","Aliquota":"10%"},{"Importo":"731,07","Aliquota":"4%"},{"Importo":"49,36","Aliquota":"10%"},{"Importo":"501,10","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":501.1,"iva":110.24},{"aliquota":10,"imponibile":341.07,"iva":34.11},{"aliquota":4,"imponibile":823.52,"iva":32.94}],"totale":1842.98}},{"in":{"Righe":[{"Importo":"275,74","Aliquota":"22%"},{"Importo":"380,12","Aliquota":"10%"},{"Importo":"99,42","Aliquota":"4%"},{"Importo":"228,25","Aliquota":"4%"},{"Importo":"595,88","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":275.74,"iva":60.66},{"aliquota":10,"imponibile":976.0,"iva":97.6},{"aliquota":4,"imponibile":327.67,"iva":13.11}],"totale":1750.78}},{"in":{"Righe":[{"Importo":"255,10","Aliquota":"22%"},{"Importo":"771,27","Aliquota":"22%"},{"Importo":"157,30","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1183.67,"iva":260.41}],"totale":1444.08}},{"in":{"Righe":[{"Importo":"273,31","Aliquota":"22%"},{"Importo":"779,54","Aliquota":"10%"},{"Importo":"482,18","Aliquota":"22%"},{"Importo":"643,59","Aliquota":"10%"},{"Importo":"711,31","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":755.49,"iva":166.21},{"aliquota":10,"imponibile":1423.13,"iva":142.31},{"aliquota":4,"imponibile":711.31,"iva":28.45}],"totale":3226.9}},{"in":{"Righe":[{"Importo":"851,30","Aliquota":"4%"},{"Importo":"603,46","Aliquota":"4%"},{"Importo":"626,43","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":626.43,"iva":137.81},{"aliquota":4,"imponibile":1454.76,"iva":58.19}],"totale":2277.19}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":589,"track":"trasforma","d":"D","pts":80,"giorno":"2026-11-08","k":20}