:"22%"},{"Importo":"623,14","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1933.86,"iva":425.45}],"totale":2359.31}},{"in":{"Righe":[{"Importo":"183,39","Aliquota":"22%"},{"Importo":"263,91","Aliquota":"10%"},{"Importo":"538,68","Aliquota":"4%"},{"Importo":"432,88","Aliquota":"4%"},{"Importo":"716,20","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":183.39,"iva":40.35},{"aliquota":10,"imponibile":263.91,"iva":26.39},{"aliquota":4,"imponibile":1687.76,"iva":67.51}],"totale":2269.31}},{"in":{"Righe":[{"Importo":"455,44","Aliquota":"22%"},{"Importo":"308,03","Aliquota":"22%"},{"Importo":"196,29","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":959.76,"iva":211.15}],"totale":1170.91}},{"in":{"Righe":[{"Importo":"822,55","Aliquota":"22%"},{"Importo":"590,30","Aliquota":"10%"},{"Importo":"773,59","Aliquota":"22%"},{"Importo":"617,84","Aliquota":"4%"},{"Importo":"640,88","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1596.14,"iva":351.15},{"aliquota":10,"imponibile":1231.18,"iva":123.12},{"aliquota":4,"imponibile":617.84,"iva":24.71}],"totale":3944.14}},{"in":{"Righe":[{"Importo":"33,82","Aliquota":"22%"},{"Importo":"853,64","Aliquota":"22%"},{"Importo":"491,80","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1379.26,"iva":303.44}],"totale":1682.7}},{"in":{"Righe":[{"Importo":"475,87","Aliquota":"4%"},{"Importo":"298,43","Aliquota":"10%"},{"Importo":"727,37","Aliquota":"22%"},{"Importo":"142,04","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":727.37,"iva":160.02},{"aliquota":10,"imponibile":440.47,"iva":44.05},{"aliquota":4,"imponibile":475.87,"iva":19.03}],"totale":1866.81}},{"in":{"Righe":[{"Importo":"890,50","Aliquota":"10%"},{"Importo":"388,08","Aliquota":"10%"},{"Importo":"871,77","Aliquota":"4%"},{"Importo":"414,47","Aliquota":"4%"},{"Importo":"493,50","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":493.5,"iva":108.57},{"aliquota":10,"imponibile":1278.58,"iva":127.86},{"aliquota":4,"imponibile":1286.24,"iva":51.45}],"totale":3346.2}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":800,"track":"trasforma","d":"D","pts":80,"giorno":"2026-11-15","k":27}