to":"610,00","Aliquota":"10%"},{"Importo":"747,27","Aliquota":"22%"},{"Importo":"809,98","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":747.27,"iva":164.4},{"aliquota":10,"imponibile":610.0,"iva":61.0},{"aliquota":4,"imponibile":809.98,"iva":32.4}],"totale":2425.05}},{"in":{"Righe":[{"Importo":"354,03","Aliquota":"4%"},{"Importo":"344,77","Aliquota":"4%"},{"Importo":"892,04","Aliquota":"22%"},{"Importo":"532,80","Aliquota":"10%"},{"Importo":"865,14","Aliquota":"10%"},{"Importo":"737,73","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1629.77,"iva":358.55},{"aliquota":10,"imponibile":1397.94,"iva":139.79},{"aliquota":4,"imponibile":698.8,"iva":27.95}],"totale":4252.8}},{"in":{"Righe":[{"Importo":"374,84","Aliquota":"22%"},{"Importo":"631,61","Aliquota":"22%"},{"Importo":"338,73","Aliquota":"22%"},{"Importo":"779,64","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":2124.82,"iva":467.46}],"totale":2592.28}},{"in":{"Righe":[{"Importo":"263,41","Aliquota":"22%"},{"Importo":"832,67","Aliquota":"22%"},{"Importo":"160,88","Aliquota":"4%"},{"Importo":"353,43","Aliquota":"22%"},{"Importo":"844,44","Aliquota":"10%"},{"Importo":"101,18","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1550.69,"iva":341.15},{"aliquota":10,"imponibile":844.44,"iva":84.44},{"aliquota":4,"imponibile":160.88,"iva":6.44}],"totale":2988.04}},{"in":{"Righe":[{"Importo":"583,98","Aliquota":"10%"},{"Importo":"600,14","Aliquota":"22%"},{"Importo":"701,54","Aliquota":"22%"},{"Importo":"375,25","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1301.68,"iva":286.37},{"aliquota":10,"imponibile":583.98,"iva":58.4},{"aliquota":4,"imponibile":375.25,"iva":15.01}],"totale":2620.69}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":920,"track":"trasforma","d":"D","pts":80,"giorno":"2026-11-19","k":31}