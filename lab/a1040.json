{"Importo":"318,89","Aliquota":"22%"},{"Importo":"788,40","Aliquota":"10%"},{"Importo":"225,14","Aliquota":"22%"},{"Importo":"187,58","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1131.69,"iva":248.97},{"aliquota":10,"imponibile":1583.01,"iva":158.3}],"totale":3121.97}},{"in":{"Righe":[{"Importo":"18,19","Aliquota":"22%"},{"Importo":"388,22","Aliquota":"4%"},{"Importo":"471,13","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":18.19,"iva":4.0},{"aliquota":4,"imponibile":859.35,"iva":34.37}],"totale":915.91}},{"in":{"Righe":[{"Importo":"533,45","Aliquota":"22%"},{"Importo":"265,42","Aliquota":"22%"},{"Importo":"42,98","Aliquota":"22%"},{"Importo":"603,15","Aliquota":"4%"},{"Importo":"177,36","Aliquota":"22%"},{"Importo":"569,20","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1019.21,"iva":224.23},{"aliquota":10,"imponibile":569.2,"iva":56.92},{"aliquota":4,"imponibile":603.15,"iva":24.13}],"totale":2496.84}},{"in":{"Righe":[{"Importo":"84,00","Aliquota":"22%"},{"Importo":"638,81","Aliquota":"22%"},{"Importo":"138,87","Aliquota":"22%"},{"Importo":"199,75","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1061.43,"iva":233.51}],"totale":1294.94}},{"in":{"Righe":[{"Importo":"639,05","Aliquota":"22%"},{"Importo":"291,05","Aliquota":"10%"},{"Importo":"251,66","Aliquota":"10%"},{"Importo":"827,51","Aliquota":"22%"},{"Importo":"125,27","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1591.83,"iva":350.2},{"aliquota":10,"imponibile":542.71,"iva":54.27}],"totale":2539.01}},{"in":{"Righe":[{"Importo":"759,20","Aliquota":"22%"},{"Importo":"474,09","Aliquota":"10%"},{"Importo":"384,17","Aliquota":"22%"},{"Importo":"714,79","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1143.37,"iva":251.54},{"aliquota":10,"imponibile":474.09,"iva":47.41},{"aliquota":4,"imponibile":714.79,"iva":28.59}],"totale":2659.79}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":1040,"track":"trasforma","d":"D","pts":80,"giorno":"2026-11-23","k":35}