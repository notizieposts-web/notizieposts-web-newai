quota":22,"imponibile":1933.5,"iva":425.37},{"aliquota":10,"imponibile":908.64,"iva":90.86}],"totale":3358.37}},{"in":{"Righe":[{"Importo":"725,88","Aliquota":"10%"},{"Importo":"515,46","Aliquota":"10%"},{"Importo":"840,51","Aliquota":"22%"},{"Importo":"820,26","Aliquota":"4%"},{"Importo":"606,88","Aliquota":"22%"},{"Importo":"297,09","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1447.39,"iva":318.43},{"aliquota":10,"imponibile":1538.43,"iva":153.84},{"aliquota":4,"imponibile":820.26,"iva":32.81}],"totale":4311.16}},{"in":{"Righe":[{"Importo":"233,68","Aliquota":"4%"},{"Importo":"454,85","Aliquota":"22%"},{"Importo":"577,42","Aliquota":"22%"},{"Importo":"69,15","Aliquota":"22%"},{"Importo":"540,43","Aliquota":"10%"},{"Importo":"32,85","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1101.42,"iva":242.31},{"aliquota":10,"imponibile":540.43,"iva":54.04},{"aliquota":4,"imponibile":266.53,"iva":10.66}],"totale":2215.39}},{"in":{"Righe":[{"Importo":"150,65","Aliquota":"22%"},{"Importo":"16,21","Aliquota":"22%"},{"Importo":"881,93","Aliquota":"22%"},{"Importo":"306,85","Aliquota":"22%"},{"Importo":"263,26","Aliquota":"22%"},{"Importo":"319,39","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1938.29,"iva":426.42}],"totale":2364.71}},{"in":{"Righe":[{"Importo":"859,56","Aliquota":"22%"},{"Importo":"270,38","Aliquota":"22%"},{"Importo":"35,01","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1164.95,"iva":256.29}],"totale":1421.24}},{"in":{"Righe":[{"Importo":"805,32","Aliquota":"10%"},{"Importo":"101,67","Aliquota":"22%"},{"Importo":"831,72","Aliquota":"22%"},{"Importo":"506,44","Aliquota":"22%"},{"Importo":"381,30","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1439.83,"iva":316.76},{"aliquota":10,"imponibile":805.32,"iva":80.53},{"aliquota":4,"imponibile":381.3,"iva":15.25}],"totale":3038.99}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":1069,"track":"trasforma","d":"D","pts":80,"giorno":"2026-11-24","k":36}