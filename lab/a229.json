":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":606.82,"iva":133.5},{"aliquota":10,"imponibile":46.41,"iva":4.64},{"aliquota":4,"imponibile":300.28,"iva":12.01}],"totale":1103.66}},{"in":{"Righe":[{"Importo":"545,37","Aliquota":"4%"},{"Importo":"181,01","Aliquota":"4%"},{"Importo":"446,55","Aliquota":"22%"},{"Importo":"368,13","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":814.68,"iva":179.23},{"aliquota":4,"imponibile":726.38,"iva":29.06}],"totale":1749.35}},{"in":{"Righe":[{"Importo":"250,99","Aliquota":"4%"},{"Importo":"153,15","Aliquota":"22%"},{"Importo":"522,01","Aliquota":"4%"},{"Importo":"69,89","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":223.04,"iva":49.07},{"aliquota":4,"imponibile":773.0,"iva":30.92}],"totale":1076.03}},{"in":{"Righe":[{"Importo":"72,34","Aliquota":"22%"},{"Importo":"178,44","Aliquota":"22%"},{"Importo":"428,06","Aliquota":"22%"},{"Importo":"847,62","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1526.46,"iva":335.82}],"totale":1862.28}},{"in":{"Righe":[{"Importo":"40,37","Aliquota":"4%"},{"Importo":"863,60","Aliquota":"22%"},{"Importo":"299,77","Aliquota":"22%"},{"Importo":"145,02","Aliquota":"4%"},{"Importo":"130,47","Aliquota":"4%"},{"Importo":"238,43","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1163.37,"iva":255.94},{"aliquota":4,"imponibile":554.29,"iva":22.17}],"totale":1995.77}},{"in":{"Righe":[{"Importo":"53,03","Aliquota":"22%"},{"Importo":"98,75","Aliquota":"22%"},{"Importo":"734,74","Aliquota":"10%"},{"Importo":"441,14","Aliquota":"22%"},{"Importo":"824,61","Aliquota":"10%"},{"Importo":"160,23","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":592.92,"iva":130.44},{"aliquota":10,"imponibile":1719.58,"iva":171.96}],"totale":2614.9}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":229,"track":"trasforma","d":"D","pts":80,"giorno":"2026-10-27","k":8}