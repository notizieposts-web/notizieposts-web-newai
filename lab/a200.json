ta":22,"imponibile":287.66,"iva":63.29}],"totale":350.95}},{"in":{"Righe":[{"Importo":"202,32","Aliquota":"4%"},{"Importo":"890,33","Aliquota":"10%"},{"Importo":"717,93","Aliquota":"10%"},{"Importo":"708,11","Aliquota":"4%"},{"Importo":"11,94","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":10,"imponibile":1608.26,"iva":160.83},{"aliquota":4,"imponibile":922.37,"iva":36.89}],"totale":2728.35}},{"in":{"Righe":[{"Importo":"807,30","Aliquota":"4%"},{"Importo":"610,48","Aliquota":"22%"},{"Importo":"358,38","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":968.86,"iva":213.15},{"aliquota":4,"imponibile":807.3,"iva":32.29}],"totale":2021.6}},{"in":{"Righe":[{"Importo":"67,29","Aliquota":"4%"},{"Importo":"64,09","Aliquota":"10%"},{"Importo":"759,40","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":10,"imponibile":823.49,"iva":82.35},{"aliquota":4,"imponibile":67.29,"iva":2.69}],"totale":975.82}},{"in":{"Righe":[{"Importo":"464,86","Aliquota":"22%"},{"Importo":"413,49","Aliquota":"22%"},{"Importo":"249,47","Aliquota":"22%"},{"Importo":"744,10","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1871.92,"iva":411.82}],"totale":2283.74}},{"in":{"Righe":[{"Importo":"645,15","Aliquota":"22%"},{"Importo":"507,53","Aliquota":"22%"},{"Importo":"512,62","Aliquota":"22%"},{"Importo":"887,05","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1665.3,"iva":366.37},{"aliquota":4,"imponibile":887.05,"iva":35.48}],"totale":2954.2}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":200,"track":"trasforma","d":"D","pts":80,"giorno":"2026-10-26","k":7}