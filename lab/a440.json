600,23","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":10,"imponibile":660.11,"iva":66.01},{"aliquota":4,"imponibile":600.23,"iva":24.01}],"totale":1350.36}},{"in":{"Righe":[{"Importo":"688,00","Aliquota":"4%"},{"Importo":"392,56","Aliquota":"22%"},{"Importo":"458,62","Aliquota":"4%"},{"Importo":"703,96","Aliquota":"10%"},{"Importo":"447,58","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":840.14,"iva":184.83},{"aliquota":10,"imponibile":703.96,"iva":70.4},{"aliquota":4,"imponibile":1146.62,"iva":45.86}],"totale":2991.81}},{"in":{"Righe":[{"Importo":"268,75","Aliquota":"4%"},{"Importo":"75,78","Aliquota":"10%"},{"Importo":"30,84","Aliquota":"22%"},{"Importo":"323,55","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":354.39,"iva":77.97},{"aliquota":10,"imponibile":75.78,"iva":7.58},{"aliquota":4,"imponibile":268.75,"iva":10.75}],"totale":795.22}},{"in":{"Righe":[{"Importo":"532,52","Aliquota":"22%"},{"Importo":"100,06","Aliquota":"22%"},{"Importo":"138,29","Aliquota":"22%"},{"Importo":"417,46","Aliquota":"22%"},{"Importo":"656,22","Aliquota":"22%"},{"Importo":"795,46","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":2640.01,"iva":580.8}],"totale":3220.81}},{"in":{"Righe":[{"Importo":"746,21","Aliquota":"4%"},{"Importo":"114,70","Aliquota":"22%"},{"Importo":"663,58","Aliquota":"10%"},{"Importo":"83,63","Aliquota":"10%"},{"Importo":"331,95","Aliquota":"22%"},{"Importo":"773,87","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1220.52,"iva":268.51},{"aliquota":10,"imponibile":747.21,"iva":74.72},{"aliquota":4,"imponibile":746.21,"iva":29.85}],"totale":3087.02}},{"in":{"Righe":[{"Importo":"279,99","Aliquota":"10%"},{"Importo":"593,92","Aliquota":"4%"},{"Importo":"609,32","Aliquota":"4%"},{"Importo":"837,69","Aliquota":"10%"},{"Importo":"251,31","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":10,"imponibile":1368.99,"iva":136.9},{"aliquota":4,"imponibile":1203.24,"iva":48.13}],"totale":2757.26}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":440,"track":"trasforma","d":"D","pts":80,"giorno":"2026-11-03","k":15}