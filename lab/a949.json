Aliquota":"22%"},{"Importo":"187,55","Aliquota":"22%"},{"Importo":"618,02","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":833.1,"iva":183.28}],"totale":1016.38}},{"in":{"Righe":[{"Importo":"339,97","Aliquota":"22%"},{"Importo":"390,25","Aliquota":"22%"},{"Importo":"180,72","Aliquota":"4%"},{"Importo":"281,38","Aliquota":"4%"},{"Importo":"382,03","Aliquota":"4%"},{"Importo":"87,94","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":730.22,"iva":160.65},{"aliquota":10,"imponibile":87.94,"iva":8.79},{"aliquota":4,"imponibile":844.13,"iva":33.77}],"totale":1865.5}},{"in":{"Righe":[{"Importo":"838,78","Aliquota":"10%"},{"Importo":"666,35","Aliquota":"22%"},{"Importo":"266,93","Aliquota":"22%"},{"Importo":"819,81","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":933.28,"iva":205.32},{"aliquota":10,"imponibile":1658.59,"iva":165.86}],"totale":2963.05}},{"in":{"Righe":[{"Importo":"873,87","Aliquota":"22%"},{"Importo":"802,75","Aliquota":"22%"},{"Importo":"673,88","Aliquota":"22%"},{"Importo":"842,24","Aliquota":"22%"},{"Importo":"287,19","Aliquota":"22%"},{"Importo":"302,19","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":3782.12,"iva":832.07}],"totale":4614.19}},{"in":{"Righe":[{"Importo":"122,76","Aliquota":"10%"},{"Importo":"737,56","Aliquota":"10%"},{"Importo":"729,74","Aliquota":"4%"},{"Importo":"602,45","Aliquota":"10%"},{"Importo":"639,22","Aliquota":"4%"},{"Importo":"598,47","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":10,"imponibile":1462.77,"iva":146.28},{"aliquota":4,"imponibile":1967.43,"iva":78.7}],"totale":3655.18}},{"in":{"Righe":[{"Importo":"176,88","Aliquota":"22%"},{"Importo":"714,72","Aliquota":"22%"},{"Importo":"487,17","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1378.77,"iva":303.33}],"totale":1682.1}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":949,"track":"trasforma","d":"D","pts":80,"giorno":"2026-11-20","k":32}