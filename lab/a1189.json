10%"},{"Importo":"338,65","Aliquota":"10%"},{"Importo":"102,13","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":458.13,"iva":100.79},{"aliquota":10,"imponibile":1018.82,"iva":101.88},{"aliquota":4,"imponibile":102.13,"iva":4.09}],"totale":1785.84}},{"in":{"Righe":[{"Importo":"828,38","Aliquota":"10%"},{"Importo":"253,52","Aliquota":"4%"},{"Importo":"50,00","Aliquota":"22%"},{"Importo":"693,11","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":50.0,"iva":11.0},{"aliquota":10,"imponibile":1521.49,"iva":152.15},{"aliquota":4,"imponibile":253.52,"iva":10.14}],"totale":1998.3}},{"in":{"Righe":[{"Importo":"619,63","Aliquota":"22%"},{"Importo":"284,91","Aliquota":"10%"},{"Importo":"375,45","Aliquota":"22%"},{"Importo":"24,20","Aliquota":"10%"},{"Importo":"191,21","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1186.29,"iva":260.98},{"aliquota":10,"imponibile":309.11,"iva":30.91}],"totale":1787.29}},{"in":{"Righe":[{"Importo":"460,41","Aliquota":"22%"},{"Importo":"365,68","Aliquota":"22%"},{"Importo":"274,35","Aliquota":"22%"},{"Importo":"755,00","Aliquota":"22%"},{"Importo":"87,35","Aliquota":"22%"},{"Importo":"44,88","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1987.67,"iva":437.29}],"totale":2424.96}},{"in":{"Righe":[{"Importo":"553,74","Aliquota":"22%"},{"Importo":"209,21","Aliquota":"4%"},{"Importo":"241,21","Aliquota":"10%"},{"Importo":"414,46","Aliquota":"22%"},{"Importo":"136,72","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1104.92,"iva":243.08},{"aliquota":10,"imponibile":241.21,"iva":24.12},{"aliquota":4,"imponibile":209.21,"iva":8.37}],"totale":1830.91}},{"in":{"Righe":[{"Importo":"669,00","Aliquota":"10%"},{"Importo":"463,84","Aliquota":"22%"},{"Importo":"693,48","Aliquota":"22%"},{"Importo":"239,84","Aliquota":"22%"},{"Importo":"64,11","Aliquota":"4%"},{"Importo":"174,12","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1571.28,"iva":345.68},{"aliquota":10,"imponibile":669.0,"iva":66.9},{"aliquota":4,"imponibile":64.11,"iva":2.56}],"totale":2719.53}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":1189,"track":"trasforma","d":"D","pts":80,"giorno":"2026-11-28","k":40}