}],"totale":2350.44}},{"in":{"Righe":[{"Importo":"844,63","Aliquota":"10%"},{"Importo":"565,20","Aliquota":"22%"},{"Importo":"776,88","Aliquota":"4%"},{"Importo":"641,03","Aliquota":"22%"},{"Importo":"51,13","Aliquota":"22%"},{"Importo":"860,40","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1257.36,"iva":276.62},{"aliquota":10,"imponibile":844.63,"iva":84.46},{"aliquota":4,"imponibile":1637.28,"iva":65.49}],"totale":4165.84}},{"in":{"Righe":[{"Importo":"146,38","Aliquota":"22%"},{"Importo":"241,09","Aliquota":"4%"},{"Importo":"386,87","Aliquota":"4%"},{"Importo":"140,54","Aliquota":"4%"},{"Importo":"317,97","Aliquota":"10%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":146.38,"iva":32.2},{"aliquota":10,"imponibile":317.97,"iva":31.8},{"aliquota":4,"imponibile":768.5,"iva":30.74}],"totale":1327.59}},{"in":{"Righe":[{"Importo":"840,64","Aliquota":"10%"},{"Importo":"249,83","Aliquota":"22%"},{"Importo":"466,50","Aliquota":"10%"},{"Importo":"813,52","Aliquota":"22%"},{"Importo":"697,60","Aliquota":"4%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":1063.35,"iva":233.94},{"aliquota":10,"imponibile":1307.14,"iva":130.71},{"aliquota":4,"imponibile":697.6,"iva":27.9}],"totale":3460.64}},{"in":{"Righe":[{"Importo":"674,20","Aliquota":"22%"},{"Importo":"790,32","Aliquota":"22%"},{"Importo":"683,47","Aliquota":"22%"},{"Importo":"880,41","Aliquota":"22%"},{"Importo":"403,87","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":3432.27,"iva":755.1}],"totale":4187.37}},{"in":{"Righe":[{"Importo":"800,52","Aliquota":"22%"},{"Importo":"546,00","Aliquota":"22%"},{"Importo":"692,90","Aliquota":"22%"},{"Importo":"189,98","Aliquota":"10%"},{"Importo":"185,94","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":2225.36,"iva":489.58},{"aliquota":10,"imponibile":189.98,"iva":19.0}],"totale":2923.92}},{"in":{"Righe":[{"Importo":"579,43","Aliquota":"4%"},{"Importo":"473,76","Aliquota":"10%"},{"Importo":"519,71","Aliquota":"22%"}]},"out":{"riepilogo":[{"aliquota":22,"imponibile":519.71,"iva":114.34},{"aliquota":10,"imponibile":473.76,"iva":47.38},{"aliquota":4,"imponibile":579.43,"iva":23.18}],"totale":1757.8}}],"guide":["Non devi saper programmare: devi saper chiedere. Descrivi all'agente input, output, formati, arrotondamenti e casi particolari.","I test nascosti contengono casi che i test visibili non mostrano: rileggi la specifica e chiediti \"e se…?\" prima di inviare.","Leggi il codice che ti propone l'agente: se non capisci una riga, chiedigli di spiegarla. Poi provalo sui test visibili.","Attento agli arrotondamenti: arrotondare a ogni passaggio o solo alla fine dà risultati diversi. La specifica dice quando."],"ref_js":"function trasforma(input){\n  var n = function(s){ return parseFloat(String(s).replace(/\\./g, '').replace(',', '.')); };\n  var by = {};\n  input.Righe.forEach(function(r){ var a = parseInt(r.Aliquota, 10); by[a] = Math.round(((by[a] || 0) + n(r.Importo)) * 100) / 100; });\n  var riep = Object.keys(by).map(Number).sort(function(a, b){ return b - a; }).map(function(a){\n    return { aliquota: a, imponibile: by[a], iva: Math.round(by[a] * a) / 100 };\n  });\n  var tot = riep.reduce(function(s, z){ return s + z.imponibile + z.iva; }, 0);\n  return { riepilogo: riep, totale: Math.round(tot * 100) / 100 };\n}","ref_py":"def trasforma(campi):\n    n = lambda s: float(str(s).replace('.', '').replace(',', '.'))\n    by = {}\n    for r in campi['Righe']:\n        a = int(r['Aliquota'].rstrip('%'))\n        by[a] = round(by.get(a, 0) + n(r['Importo']), 2)\n    riep = [{'aliquota': a, 'imponibile': by[a], 'iva': round(by[a] * a / 100, 2)} for a in sorted(by, reverse=True)]\n    return {'riepilogo': riep, 'totale': round(sum(z['imponibile'] + z['iva'] for z in riep), 2)}","gen":{"tin":1300,"tout":60},"id":320,"track":"trasforma","d":"D","pts":80,"giorno":"2026-10-30","k":11}